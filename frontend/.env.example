# Copy to .env.local
# Supabase is used in the browser ONLY for authentication (email/password + Google).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# All data goes through the Coop backend API (the Next.js app in ../backend)
VITE_API_URL=http://localhost:4000/api/v1
