{
  "name": "coop-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:plain": "next dev --port 4000",
    "build": "next build",
    "start": "next start --port 4000",
    "lint": "eslint",
    "test:db": "node supabase/tests/engine.test.mjs supabase/migrations",
    "typecheck": "tsc --noEmit",
    "stack:up": "node scripts/local-stack.mjs up",
    "stack:db": "node scripts/local-stack.mjs db",
    "stack:down": "node scripts/local-stack.mjs down",
    "test:db:pg": "node scripts/local-stack.mjs db --reset && node supabase/tests/engine.test.mjs supabase/migrations --pg",
    "test:api:smoke": "node --env-file=.env.local scripts/api-smoke.mjs",
    "test:server": "node scripts/test-server.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "jose": "^6.2.17",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "pg": "^8.23.1",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
