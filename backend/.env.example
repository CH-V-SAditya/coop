# Copy to .env.local (Supabase dashboard -> Project Settings -> API Keys)
SUPABASE_URL=http://127.0.0.1:54321
# PROTOTYPE MODE (no sign-in): the API uses the server-only SECRET key and tells
# Postgres which person it is acting as. Never put this key in the frontend or in git.
SUPABASE_SECRET_KEY=your-secret-key

# Origins allowed to call the API (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173
