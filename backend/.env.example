# Copy to .env.local (Supabase dashboard -> Project Settings -> API)
SUPABASE_URL=http://127.0.0.1:54321
# Publishable / anon key. The API forwards each user's JWT, so Row Level Security always applies.
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Origins allowed to call the API (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173
# Public URL of the frontend (used to build invitation links)
FRONTEND_URL=http://localhost:5173
